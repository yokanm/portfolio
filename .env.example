# ─────────────────────────────────────────────────────────────
# Portfolio Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Formspree contact form ID
# Sign up at https://formspree.io, create a form, copy the ID from the endpoint URL.
# e.g. https://formspree.io/f/xpzvwklr → VITE_FORMSPREE_ID=xpzvwklr
VITE_FORMSPREE_ID=

# Analytics — Umami (optional, see src/lib/analytics.ts)
# Sign up at https://umami.is (free), create a website, copy its Website ID.
VITE_UMAMI_WEBSITE_ID=
# Only needed if self-hosting Umami; defaults to Umami Cloud.
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
